{
  "name": "vuln-scan",
  "version": "0.1.1",
  "description": "Node.js CLI to scan dependency lockfiles for vulnerabilities using OSV.dev",
  "type": "module",
  "bin": {
    "vuln-scan": "./cli.js",
    "vuln-scan-cli": "./cli.js"
  },
  "files": [
